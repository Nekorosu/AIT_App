<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AIT_App.PlanSession"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*" RowSpacing="14">

        <!-- ===== Заголовок ===== -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Планирование сессии" Classes="h1"/>
            <TextBlock Text="Запланируйте даты экзаменов — система автоматически переклассифицирует оценки"
                       Classes="muted"/>
        </StackPanel>

        <!-- ===== Контент: форма слева, таблица справа ===== -->
        <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="14">

            <!-- ===== Левая карточка: форма ===== -->
            <Border Grid.Column="0" Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Новая сессия" Classes="h2"/>

                    <StackPanel Spacing="0">
                        <TextBlock Text="Предмет" Classes="label"/>
                        <ComboBox x:Name="SubjectCombo" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Spacing="0">
                        <TextBlock Text="Дата сессии" Classes="label"/>
                        <CalendarDatePicker x:Name="SessionDatePicker"
                                            HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Кнопки управления -->
                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="BtnAdd" Classes="primary"
                                Content="Добавить" Margin="0,0,8,8"/>
                        <Button x:Name="BtnEdit"
                                Content="Изменить" Margin="0,0,8,8"/>
                        <Button x:Name="BtnDelete" Classes="danger"
                                Content="Удалить" Margin="0,0,0,8"/>
                    </WrapPanel>

                    <!-- Панель режима редактирования -->
                    <Border x:Name="EditModeBar"
                            Background="#FFFBEB"
                            BorderBrush="#FDE68A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            IsVisible="False">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Stretch="Uniform" Width="14" Height="14"
                                      Fill="#A16207"
                                      Data="M12 2 L22 20 L2 20 Z M12 9v5 M12 17h.01"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Режим редактирования"
                                           FontWeight="SemiBold"
                                           Foreground="#A16207"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="EditModeLabel"
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource FgPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BtnSaveEdit" Classes="primary"
                                        Content="Сохранить"/>
                                <Button x:Name="BtnCancelEdit"
                                        Content="Отмена"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Подсказка -->
                    <Border Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Foreground="#1E40AF"
                                   Text="После изменения сессий оценки автоматически перераспределяются между типами «Текущая» и «Экзаменационная»."/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Правая карточка: таблица ===== -->
            <Border Grid.Column="1" Classes="card" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="16,12"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="Запланированные сессии"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FgPrimaryBrush}"
                                   FontSize="14"/>
                    </Border>

                    <DataGrid x:Name="SessionsGrid" Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="4"  >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Предмет"
                                                Binding="{Binding [Предмет]}" Width="*"/>
                            <DataGridTextColumn Header="Дата сессии"
                                                Binding="{Binding [ДатаСессии]}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Заглушка при отсутствии запланированных сессий -->
                    <Border x:Name="SessionsEmpty" Grid.Row="1" IsVisible="False"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                        <TextBlock Text="Нет запланированных сессий. Выберите предмет и дату, затем нажмите «Добавить»."
                                   Foreground="{StaticResource FgSecondaryBrush}"
                                   FontSize="13" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="340"/>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
