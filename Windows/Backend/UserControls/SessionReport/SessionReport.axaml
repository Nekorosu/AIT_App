<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AIT_App.SessionReport"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto,*" RowSpacing="14">

        <!-- ===== Строка 0: верхняя панель ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Отчёт по сессии" Classes="h1"/>
                <TextBlock Text="Экзаменационные оценки и успеваемость по предметам"
                           Classes="muted"/>
            </StackPanel>

            <Button Grid.Column="1" x:Name="BtnExport" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Stretch="Uniform" Width="14" Height="14"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="2" Fill="Transparent"
                          StrokeJoin="Round" StrokeLineCap="Round"
                          Data="M12 3v12 M7 10l5 5 5-5 M5 21h14"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Экспорт" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== Строка 1: фильтры ===== -->
        <Border Grid.Row="1" Classes="card" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">

                <TextBlock Grid.Column="0" Text="Группа"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource FgSecondaryBrush}"
                           Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="GroupCombo"
                          PlaceholderText="Выберите группу"
                          HorizontalAlignment="Stretch"
                          MaxWidth="220"/>

                <TextBlock Grid.Column="2" Text="Дата с"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource FgSecondaryBrush}"
                           Margin="20,0,10,0"/>
                <CalendarDatePicker Grid.Column="3" x:Name="DateFromPicker"
                                    Width="160"/>

                <TextBlock Grid.Column="4" Text="по"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource FgSecondaryBrush}"
                           Margin="14,0,10,0"/>
                <CalendarDatePicker Grid.Column="5" x:Name="DateToPicker"
                                    Width="160"/>

                <Button Grid.Column="6" x:Name="BtnShow"
                        Classes="primary"
                        Content="Построить"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== Строка 2: pivot-таблица оценок ===== -->
        <Border Grid.Row="2" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Padding="16,12"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Оценки студентов"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FgPrimaryBrush}"
                                   FontSize="14"/>
                        <TextBlock Text="Строки — студенты, столбцы — предметы"
                                   FontSize="12"
                                   Foreground="{StaticResource FgSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="GradesGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="4"/>
            </Grid>
        </Border>

        <!-- ===== Строка 3: разделитель пустой (gap уже от RowSpacing) ===== -->
        <Panel Grid.Row="3" Height="0"/>

        <!-- ===== Строка 4: таблица успеваемости ===== -->
        <Border Grid.Row="4" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Padding="16,12"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="Успеваемость по предметам"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource FgPrimaryBrush}"
                               FontSize="14"/>
                </Border>

                <DataGrid x:Name="PerfGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="4"  >
                    <DataGrid.Columns>
    <DataGridTextColumn Header="Предмет"
                        Binding="{Binding [Предмет]}" Width="*"/>
    <DataGridTextColumn Header="Средний балл"
                        Binding="{Binding [СреднийБалл]}" Width="*"/>
    <DataGridTextColumn Header="Качество % (4 и 5)"
                        Binding="{Binding [КачествоПроц]}" Width="*"/>
    <DataGridTextColumn Header="Успеваемость % (3, 4, 5)"
                        Binding="{Binding [УспеваемостьПроц]}" Width="*"/>
    <DataGridTextColumn Header="Всего оценок"
                        Binding="{Binding [ВсегоОценок]}" Width="*"/>
</DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
