<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AIT_App.Journal"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="14">

        <!-- ===== Строка 0: верхняя панель с заголовком и действиями ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Журнал" Classes="h1"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Name="BtnExport">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Stretch="Uniform" Width="14" Height="14"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="2" Fill="Transparent"
                              StrokeJoin="Round" StrokeLineCap="Round"
                              Data="M12 3v12 M7 10l5 5 5-5 M5 21h14"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Экспорт" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnToggleAdd" Classes="primary">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Stretch="Uniform" Width="12" Height="12"
                              Stroke="White" StrokeThickness="2.5"
                              Fill="Transparent"
                              StrokeJoin="Round" StrokeLineCap="Round"
                              Data="M12 5v14 M5 12h14"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Добавить оценку" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Строка 1: фильтры в карточке ===== -->
        <Border Grid.Row="1" Classes="card" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,Auto">

                <TextBlock Grid.Column="0" Text="Группа"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource FgSecondaryBrush}"
                           Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="GroupCombo"
                          PlaceholderText="Выберите группу"
                          HorizontalAlignment="Stretch"
                          MaxWidth="220"/>

                <TextBlock Grid.Column="2" Text="Предмет"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource FgSecondaryBrush}"
                           Margin="20,0,10,0"/>
                <ComboBox Grid.Column="3" x:Name="SubjectCombo"
                          PlaceholderText="Сначала группу"
                          HorizontalAlignment="Stretch"
                          MaxWidth="220"
                          IsEnabled="False"/>

                <!-- Тип оценки в виде pill-переключателей -->
                <TextBlock Grid.Column="4" Text="Тип"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource FgSecondaryBrush}"
                           Margin="20,0,10,0"/>
                <Border Grid.Column="5" Background="#F3F4F6" CornerRadius="8"
                        Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="BtnTypeAll" Classes="pill active" Content="Все"/>
                        <Button x:Name="BtnTypeCurrent" Classes="pill" Content="Текущая"/>
                        <Button x:Name="BtnTypeExam" Classes="pill" Content="Экзаменационная"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="6" x:Name="BtnLoad"
                        Content="Загрузить"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"/>

                <!-- Скрытый ComboBox типа: остаётся в DOM для совместимости с code-behind -->
                <ComboBox x:Name="TypeCombo" IsVisible="False" Width="0" Height="0"/>
            </Grid>
        </Border>

        <!-- ===== Строка 2: панель добавления оценки (скрыта по умолчанию) ===== -->
        <Border x:Name="AddPanel" Grid.Row="2" Classes="card"
                Background="#FFFBEB"
                BorderBrush="#FDE68A"
                IsVisible="False">
            <StackPanel Spacing="10">
                <TextBlock Text="Добавить оценку" Classes="h2"/>
                <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="10">

                    <StackPanel>
                        <TextBlock Text="Студент" Classes="label"/>
                        <ComboBox x:Name="AddStudentCombo" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Предмет" Classes="label"/>
                        <ComboBox x:Name="AddSubjectCombo" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Дата" Classes="label"/>
                        <CalendarDatePicker x:Name="AddDatePicker" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Оценка" Classes="label"/>
                        <ComboBox x:Name="AddGradeCombo" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Button x:Name="BtnAdd" Grid.Column="4"
                            Content="Сохранить" Classes="primary"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Строка 3: панель редактирования (скрыта по умолчанию) ===== -->
        <Border x:Name="EditPanel" Grid.Row="3" Classes="card"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                IsVisible="False">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBlock x:Name="EditStatusLabel"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="13"/>
                <ComboBox x:Name="EditGradeCombo" Grid.Column="1"
                          Width="90" VerticalAlignment="Center"/>
                <Button x:Name="BtnSaveEdit" Grid.Column="2" Classes="primary"
                        Content="Изменить" VerticalAlignment="Center" IsEnabled="False"/>
                <Button x:Name="BtnDelete" Grid.Column="3" Classes="danger"
                        Content="Удалить" VerticalAlignment="Center" IsEnabled="False"/>
                <Button x:Name="BtnCancelEdit" Grid.Column="4"
                        Content="Отмена" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== Строка 4: основная таблица в карточке ===== -->
        <Border Grid.Row="4" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">

                <!-- Заголовок карточки -->
                <Border Grid.Row="0" Padding="16,12"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" x:Name="GridHeaderLabel"
                                   Text="Оценки"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FgPrimaryBrush}"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="GridMetaLabel"
                                   Foreground="{StaticResource FgSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Таблица оценок -->
                <DataGrid x:Name="JournalGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserReorderColumns="False"
                          Margin="4"  >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО"
                                            Binding="{Binding [ФИО]}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Предмет"
                                            Binding="{Binding [Предмет]}"
                                            Width="180"/>
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding [Дата], StringFormat=\{0:dd.MM.yyyy\}}"
                                            Width="110"/>

                        <!-- Цветной бейдж для оценки -->
                        <DataGridTemplateColumn Header="Оценка" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Left"
                                            Background="{Binding [Оценка], Converter={StaticResource GradeBgConv}}"
                                            CornerRadius="6"
                                            Padding="10,3"
                                            MinWidth="32">
                                        <TextBlock Text="{Binding [Оценка]}"
                                                   Foreground="{Binding [Оценка], Converter={StaticResource GradeFgConv}}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Тип"
                                            Binding="{Binding [Тип]}"
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ===== Строка 5: статусная строка + подсказка ===== -->
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" x:Name="StatusLabel"
                       Foreground="{StaticResource FgSecondaryBrush}"
                       FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="HintLabel"
                       Foreground="{StaticResource FgMutedBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Text="↑↓ — выбор строки  •  2 3 4 5 Н — выставить оценку"/>
        </Grid>
    </Grid>
</UserControl>
