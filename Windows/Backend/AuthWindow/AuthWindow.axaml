<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AIT_App.AuthWindow"
        Title="Электронный журнал — Вход"
        Width="440"
        Height="520"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{StaticResource BgAppBrush}">

    <!-- Карточка по центру окна -->
    <Border Margin="32"
            Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="32"
            VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="20">

            <!-- Логотип / заголовок -->
            <StackPanel Grid.Row="0" Spacing="6" HorizontalAlignment="Center">
                <Border Width="48" Height="48"
                        Background="{StaticResource AccentPrimaryBrush}"
                        CornerRadius="10"
                        HorizontalAlignment="Center">
                    <!-- Книжная иконка -->
                    <Path Data="M4 4 L20 4 L20 22 L12 19 L4 22 Z M12 4 L12 19"
                          Stroke="White" StrokeThickness="2"
                          StrokeJoin="Round" StrokeLineCap="Round"
                          Fill="Transparent"
                          Stretch="Uniform"
                          Width="24" Height="24"/>
                </Border>
                <TextBlock Text="Электронный журнал"
                           Classes="h1"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Вход в систему"
                           Classes="muted"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Статус соединения -->
            <Border Grid.Row="1"
                    Background="#F9FAFB"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image x:Name="ConnectionIcon"
                           Width="18" Height="18"
                           IsVisible="False"/>
                    <TextBlock x:Name="ConnectionStatusText"
                               Text="Проверка соединения..."
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource FgSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Форма -->
            <StackPanel Grid.Row="2" Spacing="12" VerticalAlignment="Top">
                <StackPanel Spacing="0">
                    <TextBlock Text="Логин" Classes="label"/>
                    <ComboBox x:Name="LoginCombo"
                              IsEditable="False"
                              PlaceholderText="Выберите логин"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="0">
                    <TextBlock Text="Пароль" Classes="label"/>
                    <TextBox x:Name="PasswordInput"
                             PasswordChar="*"
                             Watermark="Введите пароль"/>
                </StackPanel>
            </StackPanel>

            <!-- Кнопка входа -->
            <Button x:Name="LoginButton"
                    Grid.Row="3"
                    Content="Войти"
                    Classes="primary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    MinHeight="40"
                    IsEnabled="False"/>
        </Grid>
    </Border>
</Window>
